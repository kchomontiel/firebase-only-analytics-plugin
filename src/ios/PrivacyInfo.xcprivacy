<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
 "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- FirebaseCore / RemoteConfig: usa UserDefaults -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string> <!-- Configuración de usuario / almacenamiento de preferencias -->
            </array>
        </dict>

        <!-- FirebaseAuth: usa Keychain para credenciales -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryKeychain</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>AC23.1</string> <!-- Almacenamiento seguro de tokens/credenciales -->
            </array>
        </dict>

        <!-- FirebaseCrashlytics: accede timestamps de archivos -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>0A12.1</string> <!-- Diagnóstico y estabilidad de la app -->
            </array>
        </dict>

        <!-- FirebaseMessaging: identificador del dispositivo (push token) -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDeviceIdentifier</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>DA04.1</string> <!-- Envío de notificaciones push -->
            </array>
        </dict>

        <!-- FirebasePerformance: mide tiempos de red y recursos -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>0A12.2</string> <!-- Monitoreo de rendimiento -->
            </array>
        </dict>

        <!-- FirebaseDynamicLinks: acceso a URLs / portapapeles (si habilitado) -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryClipboard</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>0C05.1</string> <!-- Manejo de enlaces dinámicos -->
            </array>
        </dict>
    </array>
</dict>
</plist>