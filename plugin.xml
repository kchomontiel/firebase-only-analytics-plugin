<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0" 
        xmlns:android="http://schemas.android.com/apk/res/android" 
        id="cordova-plugin-firebase" version="2.0.5">
    <name>Google Firebase Plugin</name>
    <description>Cordova plugin for Google Firebase</description>
    <license>MIT</license>
    <keywords>cordova,phonegap,ionic,firebase</keywords>
    <repo>https://github.com/kchomontiel/firebase-only-analytics-plugin.git</repo>

    <js-module name="FirebasePlugin" src="www/firebase.js">
        <clobbers target="fp" />
    </js-module>

    <hook type="before_plugin_install" src="scripts/configurations/installDependencies.js" />
    <hook type="before_plugin_install" src="scripts/configurations/unzipAndCopyConfigurations.js" />
    <hook type="before_plugin_install" src="scripts/configurations/unzipAndCopySound.js" />
    <hook type="before_plugin_install" src="scripts/ios/cleanOutSystemsCache.js" />
    <hook type="before_plugin_install" src="scripts/ios/cleanCocoaPodsRepos.js" />
    <hook type="after_plugin_install" src="scripts/ios/removeAppDelegateFile.js" />
    <hook type="after_plugin_install" src="scripts/ios/cleanProjectReferences.js" />
    <hook type="after_plugin_install" src="scripts/ios/initializeFirebase.js" />
    <hook type="after_plugin_install" src="scripts/ios/forceFixAllSettings.js" />
    <hook type="after_plugin_install" src="scripts/ios/fixSwiftSettings.js" />
    <hook type="after_plugin_install" src="scripts/ios/fixDeploymentTargets.js" />
    <hook type="after_plugin_install" src="scripts/ios/verifyPluginFiles.js" />

    <preference name="APP_DOMAIN" default="/" />
    <preference name="APP_PATH" default="/" />
    <preference name="DEPLOYMENT-TARGET" default="12.0" />
    <preference name="IPHONEOS_DEPLOYMENT_TARGET" default="12.0" />

    <platform name="android">
        <config-file parent="/*" target="res/xml/config.xml">
            <feature name="FirebasePlugin">
                <param name="android-package" value="org.apache.cordova.firebase.FirebasePlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>
        <config-file parent="/*" target="AndroidManifest.xml">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
            <uses-permission android:name="android.permission.WAKE_LOCK" />
            <uses-permission android:name="com.google.android.c2dm.permission.RECEIVE" />
            <permission android:name="$PACKAGE_NAME.permission.C2D_MESSAGE" android:protectionLevel="signature" />
            <uses-permission android:name="$PACKAGE_NAME.permission.C2D_MESSAGE" />
        </config-file>

        <source-file src="src/android/FirebasePlugin.java" target-dir="src/org/apache/cordova/firebase" />
        <source-file src="src/android/OnNotificationOpenReceiver.java" target-dir="src/org/apache/cordova/firebase" />
        <source-file src="src/android/FirebasePluginInstanceIDService.java" target-dir="src/org/apache/cordova/firebase" />
        <source-file src="src/android/FirebasePluginMessagingService.java" target-dir="src/org/apache/cordova/firebase" />
        <source-file src="src/android/FirebasePluginMessageReceiver.java" target-dir="src/org/apache/cordova/firebase" />
        <source-file src="src/android/FirebasePluginMessageReceiverManager.java" target-dir="src/org/apache/cordova/firebase" />
        <source-file src="src/android/OnNotificationOpenActivity.java" target-dir="src/org/apache/cordova/firebase" />
        <source-file src="src/android/cordova-plugin-firebase-colors.xml" target-dir="res/values" />
        <source-file src="src/android/cordova-plugin-firebase-strings.xml" target-dir="res/values" />
        <source-file src="src/android/build.gradle" target-dir="." />
        <source-file src="src/android/build-extras.gradle" target-dir="." />

        <framework src="com.google.firebase:firebase-analytics:20.0.2" />
        <framework src="com.google.firebase:firebase-messaging:23.0.0" />
        <framework src="com.google.firebase:firebase-config:21.0.1" />
        <framework src="com.google.firebase:firebase-perf:20.0.4" />
        <framework src="com.google.firebase:firebase-dynamic-links:21.0.0" />
        <framework src="com.google.firebase:firebase-iid:21.1.0" />
        <framework src="com.google.firebase:firebase-crashlytics:18.2.7" />

        <resource-file src="google-services.json" target="app/google-services.json" />
    </platform>

    <platform name="ios">
        <config-file parent="/*" target="config.xml">
            <feature name="FirebasePlugin">
                <param name="ios-package" value="FirebasePlugin" />
                <param name="onload" value="true" />
            </feature>
        </config-file>
        
        <!-- iOS Build Configuration -->
        <config-file parent="/*" target="config.xml">
            <preference name="IPHONEOS_DEPLOYMENT_TARGET" value="12.0" />
            <preference name="SWIFT_VERSION" value="5.0" />
            <preference name="SWIFT_OPTIMIZATION_LEVEL" value="-Onone" />
        </config-file>

        <config-file target="*-Info.plist" parent="CFBundleURLTypes">
            <array>
                <dict>
                    <key>CFBundleURLSchemes</key>
                    <array>
                        <string>com.entel.movil.autoactivacion</string>
                    </array>
                </dict>
            </array>
        </config-file>

        <config-file parent="aps-environment" target="*/Entitlements-Debug.plist">
            <string>development</string>
        </config-file>
        <config-file parent="aps-environment" target="*/Entitlements-Release.plist">
            <string>production</string>
        </config-file>

        <resource-file src="GoogleService-Info.plist" target="./GoogleService-Info.plist" />
        
        <source-file src="src/ios/FirebasePlugin.swift" />
        
        
        <!-- Firebase dependencies for iOS - ENHANCED -->
        <podspec>
            <config>
                <!-- Use only CDN source to avoid conflicts -->
                <source url="https://cdn.cocoapods.org/"/>
                <ios deployment-target="$DEPLOYMENT-TARGET"/>
            </config>
            <pods use-frameworks="true">
                <!-- Exact versions to avoid conflicts -->
                <pod name="Firebase/Core" spec="11.15.0"/>
                <pod name="Firebase/Analytics" spec="11.15.0"/>
                <pod name="Firebase/Messaging" spec="11.15.0"/>
                <pod name="Firebase/Installations" spec="11.15.0"/>
            </pods>
            <!-- Enhanced post install script to fix ALL build settings conflicts -->
            <post_install>
                installer.pods_project.targets.each do |target|
                    target.build_configurations.each do |config|
                        # Force deployment target to 12.0 for all pods
                        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
                        
                        # Fix Swift optimization levels for all Swift targets
                        if target.name.include?('Firebase') || target.name == 'FirebasePlugin' || target.name.include?('Swift')
                            config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
                        end
                        
                        # Fix Swift language version
                        config.build_settings['SWIFT_VERSION'] = '5.0'
                        
                        # Remove problematic build settings that cause conflicts
                        config.build_settings.delete('EMBEDDED_CONTENT_CONTAINS_SWIFT')
                        config.build_settings.delete('ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES')
                        config.build_settings.delete('LD_RUNPATH_SEARCH_PATHS')
                        
                        # Set proper Swift standard library embedding
                        config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'NO'
                        
                        # Fix library search paths
                        config.build_settings['LD_RUNPATH_SEARCH_PATHS'] = [
                            '$(inherited)',
                            '@executable_path/Frameworks',
                            '@loader_path/Frameworks'
                        ]
                        
                        # Ensure proper Swift compilation
                        config.build_settings['SWIFT_COMPILATION_MODE'] = 'singlefile'
                        config.build_settings['SWIFT_ACTIVE_COMPILATION_CONDITIONS'] = 'DEBUG'
                    end
                end
                
                # Also fix the main project targets
                installer.aggregate_targets.each do |target|
                    target.user_project.targets.each do |project_target|
                        project_target.build_configurations.each do |config|
                            # Apply same fixes to main project targets
                            config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
                            config.build_settings['SWIFT_VERSION'] = '5.0'
                            config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
                            config.build_settings['ALWAYS_EMBED_SWIFT_STANDARD_LIBRARIES'] = 'NO'
                        end
                    end
                end
            </post_install>
        </podspec>
    </platform>
</plugin>
